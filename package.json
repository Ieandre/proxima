{
  "name": "chat-anonyme-proximite",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme de chat anonyme de proximité — privacy by design, temps réel, éphémère.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file=.env server/index.js",
    "dev": "node --env-file=.env --watch server/index.js",
    "dev:local": "node --env-file=.env --watch scripts/dev-local.js",
    "build:brand": "node scripts/build-brand-assets.js",
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "test:e2e": "node --test \"test-e2e/**/*.e2e.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "build:geo": "node scripts/build-geo.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "express": "^4.21.2",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
