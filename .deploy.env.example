# Modèle de configuration de déploiement — copier en `.deploy.env` puis renseigner.
#
# `.deploy.env` n'est PAS versionné et n'est pas envoyé sur l'hôte : il ne décrit
# que votre cible de déploiement. Les secrets de production (OPERATOR_SECRET,
# REDIS_URL…) ne vivent pas ici mais dans l'unité systemd de l'hôte.
#
# Chargé automatiquement par deploy.sh, logs.sh et setup-onion.sh.

# Hôte cible (IP ou nom).
PROXIMA_HOST=

# Compte d'administration : sudo entier, utilisé par logs.sh et setup-onion.sh.
PROXIMA_USER=ubuntu

# Compte de déploiement créé par setup-ci-deploy.sh : il possède l'arborescence
# distante et ne peut, en root, que relancer le service. deploy.sh passe par lui,
# comme la CI — un seul propriétaire, donc aucun conflit de permissions.
PROXIMA_DEPLOY_USER=deploy
PROXIMA_KEY="$HOME/.ssh/id_ed25519"
PROXIMA_PATH=/opt/proxima

# URL publique — cible du contrôle de santé en fin de déploiement.
PROXIMA_URL=

# Domaine clearnet canonique, servi par le reverse-proxy (setup-onion.sh).
PROXIMA_DOMAIN=

# Ancien domaine, optionnel : redirection permanente qui préserve le référencement
# acquis avant une bascule. Laisser vide s'il n'y en a pas.
PROXIMA_LEGACY_DOMAIN=
