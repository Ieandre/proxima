# Modèle de configuration locale — copier en `.env` puis renseigner les valeurs.
# Le serveur charge ce fichier via `node --env-file=.env` (scripts npm start/dev).

# Jeton unique de la console de modération (/operator). OBLIGATOIRE pour l'accès admin.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPERATOR_SECRET=

# Point de contact publié (DSA art.11-12), affiché sur les pages légales. Optionnel.
# Défaut : proximachat@proton.me (cf. config.js).
CONTACT_EMAIL=proximachat@proton.me

# Adresse du service onion Tor (design 2026-07-29). Vide = aucune annonce :
# ni en-tête `Onion-Location`, ni mention dans l'interface.
#
# ⚠ EN PRODUCTION, cette variable va dans l'UNITÉ SYSTEMD, pas dans ce fichier :
#   `deploy.sh` fait un `rsync --delete` sur /opt/proxima, qui écraserait ou
#   supprimerait un `.env` posé sur la VM. Voir DOCUMENTATION-TECHNIQUE.md § Accès Tor.
ONION_HOST=

# Plafond global du trafic onion par fenêtre d'anti-spam. Défaut : RL_MAX × 50.
# Derrière l'onion tous les visiteurs partagent une IP : ce plafond borne l'abus
# massif, tandis qu'un seau par connexion empêche un bavard de faire taire les
# autres. À réviser sur les compteurs de la console opérateur, pas à l'intuition.
# ONION_RL_GLOBAL_MAX=1500

# --- Audience (console opérateur, onglet « Audience ») ----------------------
# Mesure faite PAR LE SERVEUR : aucun script, aucun cookie, aucun identifiant de
# visiteur. Rien à installer, rien à déclarer — les valeurs ci-dessous ne servent
# qu'à régler la conservation et la finesse.

# `0` coupe entièrement la collecte. Tout le reste continue de fonctionner.
# ANALYTICS=1

# Durée de conservation des compteurs, en jours. RG-01 vaut aussi pour les
# statistiques : passé ce délai, elles disparaissent d'elles-mêmes.
# ANALYTICS_RETENTION_DAYS=30

# Pas de relevé de l'affluence. Il fixe aussi le nombre de créneaux par jour
# (86 400 000 / pas), donc la taille — bornée — du relevé journalier.
# ANALYTICS_SAMPLE_MS=300000

# Fuseau de découpe des journées. Celui de l'exploitant, pas UTC : un tableau de
# bord dont la journée commence à 2 h du matin ne se lit pas.
# ANALYTICS_TZ=Europe/Paris

# Plafond de domaines référents distincts par jour. Le champ est alimenté par un
# tiers (l'en-tête `Referer`) : sans plafond, sa cardinalité ne serait pas bornée.
# ANALYTICS_MAX_REFERRERS=200
